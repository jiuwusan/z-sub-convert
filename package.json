{
  "name": "clash-sub-convert",
  "version": "1.0.0",
  "description": "Clash.Meta subscription grouping and template converter",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "lint": "eslint . --max-warnings=0",
